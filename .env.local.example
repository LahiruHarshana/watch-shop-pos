NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Local MongoDB (install MongoDB Community, start mongod — no internet required)
MONGODB_URI=mongodb://127.0.0.1:27017/watch-shop-pos

# Remote Atlas (needs DNS/internet + Network Access IP allowlist)
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/watch-shop-pos?retryWrites=true&w=majority

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
